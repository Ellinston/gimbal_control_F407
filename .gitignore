# Publish only source, build configuration and host tests at the repository root.
/*
!/.gitignore
!/README.md
!/Bsp/
!/Core/
!/device/
!/Drivers/
!/Task/
!/cmake/
!/tests/
!/CMakeLists.txt
!/CMakePresets.json
!/gimbal_1.ioc
!/openocd.cfg
!/startup_stm32f407xx.s
!/STM32F407XX_FLASH.ld

# Build outputs and local caches inside allowed directories
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.exe
__pycache__/

# Local IDE and agent settings
CMakeUserPresets.json
